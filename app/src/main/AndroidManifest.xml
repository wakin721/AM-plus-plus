<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="dev.amenhancer.module.permission.REQUEST_CURRENT_SONG_ID" />
    <uses-permission android:name="dev.amenhancer.module.permission.REQUEST_LIBRARY_REFRESH" />
    <uses-permission android:name="dev.amenhancer.module.permission.REQUEST_USB_BIT_PERFECT_STATUS" />

    <queries>
        <package android:name="com.apple.android.music" />
    </queries>

    <permission
        android:name="dev.amenhancer.module.permission.REQUEST_CURRENT_SONG_ID"
        android:protectionLevel="signature" />

    <permission
        android:name="dev.amenhancer.module.permission.REQUEST_LIBRARY_REFRESH"
        android:protectionLevel="signature" />

    <permission
        android:name="dev.amenhancer.module.permission.REQUEST_USB_BIT_PERFECT_STATUS"
        android:protectionLevel="signature" />

    <application
        android:name=".ModuleApplication"
        android:allowBackup="false"
        android:description="@string/xposed_description"
        android:icon="@drawable/ic_module"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppleMusicEnhancer">

        <!--
          Empty provider used only for a narrow URI permission grant to Apple
          Music. On Android 11+ that grant makes the AM++ package visible to the
          injected Apple Music process so it can bind the exported USB broker.
        -->
        <provider
            android:name=".usb.UsbDirectVisibilityProvider"
            android:authorities="${applicationId}.usb-direct-visibility"
            android:exported="false"
            android:grantUriPermissions="true">
            <grant-uri-permission android:path="/bridge" />
        </provider>

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.UsbBitPerfectSettingsActivity"
            android:exported="false" />

        <!--
          Disabled until the user opts into USB Direct UAC. When enabled, the
          platform USB attach resolver can show its native "open with AM++"
          permission/default-app dialog for a connected DAC.
        -->
        <activity
            android:name=".usb.UsbDirectPermissionActivity"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_direct_device_filter" />
        </activity>

        <!--
          Cross-UID bridge used by the Xposed code running inside Apple Music.
          The service is exported because the caller has Apple Music's UID; it
          validates Message.sendingUid against com.apple.android.music before
          returning any ParcelFileDescriptor.
        -->
        <service
            android:name=".usb.UsbDirectDeviceBrokerService"
            android:exported="true" />

        <activity-alias
            android:name=".LauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_module"
            android:label="@string/app_name"
            android:targetActivity=".ui.SettingsActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>